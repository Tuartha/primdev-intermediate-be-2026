// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   @db.VarChar(255)
  role      String   @default("USER")
  createdAt DateTime @default(now())

  profiles Profiles?
  borrowings Borrowings[] 
  reviews    Reviews[]

  // Index untuk registration trend query (GROUP BY createdAt)
  @@index([createdAt])
}

model Books {
  id         Int      @id @default(autoincrement())
  categoryId Int?
  title      String
  author     String
  year       Int
  isbn       String?  @unique
  cloudinaryId String? 
  totalCopies  Int      @default(1)
  available  Boolean  @default(true)
  createdAt  DateTime @default(now())

  categories Categories? @relation(fields: [categoryId], references: [id])
  borrowings Borrowings[] 
  reviews    Reviews[]

  // Index untuk join category ranking
  @@index([categoryId])
}

model Profiles {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  address   String?
  phone     String?
  createdAt DateTime @default(now())

  user Users @relation(fields: [userId], references: [id])
}

model Categories {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  
  books Books[]
}

model Borrowings {
  id          Int       @id @default(autoincrement())
  userId      Int
  bookId      Int
  borrow_date DateTime  @default(now())
  returned_at DateTime?
  createdAt   DateTime  @default(now())
  borrower    Users     @relation(fields: [userId], references: [id])
  book        Books     @relation(fields: [bookId], references: [id])

  // Index untuk filter borrowing aktif (belum dikembalikan)
  @@index([returned_at])
  // Index untuk filter berdasarkan tanggal pinjam (date range queries)
  @@index([borrow_date])
  // Composite index: sering query berdasarkan bookId untuk ranking buku terpopuler
  @@index([bookId, returned_at])
  // Composite index: query per-user borrowing
  @@index([userId, borrow_date])
}

model Reviews {
  id          Int       @id @default(autoincrement())
  rating      Int
  comment     String
  userId      Int
  bookId      Int
  createdAt   DateTime  @default(now())

  user        Users     @relation(fields: [userId], references: [id])
  book        Books     @relation(fields: [bookId], references: [id])
}
